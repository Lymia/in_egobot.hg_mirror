16:57:27 <elliott> mergeByteString :: Vector -> FungeSpace -> ByteString -> (Vector, FungeSpace)
16:57:27 <elliott> mergeByteString (ox,oy) fs s = ((by,bx),fs')
16:57:28 <elliott>   where ((_,by),fs',_,bx) = B.foldl' byte ((ox,oy),fs,False,0) s
16:57:28 <elliott>         byte (p@(x,y),fs,lastWasCR,biggestX) w
16:57:28 <elliott>           | w == ff || (w == lf && lastWasCR) = (p, fs, False, biggestX)
16:57:28 <elliott>           | w == cr || w == lf = ((ox,y+1), fs, w == cr, biggestX)
16:57:30 <elliott>           | w == space = ((x+1,y), fs, False, max (x+1) biggestX)
16:57:32 <elliott>           | otherwise = ((x+1,y), insertFS p (fromIntegral w) fs, False, max (x+1) biggestX)
