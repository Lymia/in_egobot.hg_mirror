						<!-- firstHeading -->
			<h1 id="firstHeading" class="firstHeading"><span dir="auto">BF Joust</span></h1>
			<!-- /firstHeading -->
			<!-- bodyContent -->
			<div id="bodyContent">
								<!-- tagline -->
				<div id="siteSub">From Esolang</div>
				<!-- /tagline -->
