#!/usr/bin/env perl
# Classy contenders convey their code creators!
use strict;
use warnings;
#(
my ($fh, $line, $i, $j);

# Include our own code
open $fh, "<", $0;
while ($line = <$fh>) {
    chomp $line;
    print "$line\n";
    #(
    if ($line eq "__END__") {
        print "\n";
        last;
    }
    #)%0
}
close $fh;

my @decoysize = (27, 27, 13, 13, 7, 7, 1, 1);
my @shortdecoysize = (85, 85, 27, 27);

# Now the actual BFJoust code:

# First, skip past the first nine, leaving small decoys
print "(>+>-)*4>";

# Now move on, leaving a different trail of decoys per length
#(
for ($i = 10; $i <= 30; $i++) {
    print "[";

    # If we're here, there was something at this length. Leave the appropriate number of decoys ... (
    if ($i > 14) {
        print "(<)*8";
        #(
        for ($j = 0; $j < $i - 10 && $j <= $#decoysize; $j++) {
            print "<(" . (($j % 3 == 0) ? "+" : "-") . ")*" . $decoysize[$j];
        }
        #)%0 (
        for ($j = 0; $j < $i - 10 && $j <= $#decoysize; $j++) {
            print ">";
        }
        #)%0
        print "(>)*8";
    } elsif ($i > 10)
    #)%0 (
    {
        print "(<)*8";
        #(
        for ($j = 0; $j < $i - 10 && $j <= $#shortdecoysize; $j++) {
            print "<(" . (($j % 2 == 0) ? "+" : "-") . ")*" . $shortdecoysize[$j];
        }
        #)%0 (
        for ($j = 0; $j < $i - 10 && $j <= $#shortdecoysize; $j++) {
            print ">";
        }
        #)%0
        print "(>)*8";
    }
    #)%0 (

    if ($i == 30) {
        # On the last cell, just go for it!
        print "(-)*100[[-]]";
    } else
    #)%0 (
    {
        # Now for the philip core
        print <<END;
    (
      ([+{ ([-{ (-)*100(-.)*32 >
      ([+{ ([-{ (-)*100(-.)*32 >
      ([+{ ([-{ (-)*100(-.)*32 >
      ([+{ ([-{ (-)*100(-.)*32 >
      ([+{ ([-{ (-)*100(-.)*32 >
      ([+{ ([-{ (-)*100(-.)*32 >
      ([+{ ([-{ (-)*100(-.)*32 >
      ([+{ ([-{ (-)*100(-.)*32 >
        ([[-]]>)*21
      }])%8 }])%4
      }])%8 }])%4
      }])%8 }])%4
      }])%8 }])%4
      }])%8 }])%4
      }])%8 }])%4
      }])%8 }])%4
      }])%8 }])%4 +>
    )*21
END
    }
    #)

    print "]" . (($i % 2 == 0) ? "+" : "-") . ">";
}
#)%0
print "\n";
#)*0
