03:27:37 <elliott> mergeByteString :: Vector -> FungeSpace -> ByteString -> FungeSpace
03:27:38 <elliott> mergeByteString (ox,oy) fs = snd . foldl' byte ((ox,oy),fs,False)
03:27:38 <elliott>   where byte (p@(x,y),fs,lastWasCR) w
03:27:38 <elliott>           | w == ff || (w == lf && lastWasCR) = (p, fs, False)
03:27:38 <elliott>           | w == cr || w == lf = ((x,y+1), fs, w == cr)
03:27:38 <elliott>           | w == space = ((x+1,y), fs, False)
03:27:40 <elliott>           | otherwise = ((x+1,y), insertFS p (fromIntegral w) fs, False)
