17:34:59 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :loop :: Vector -> Vector -> Vector -> Vector
17:35:00 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :loop (x,y) (dx,dy) (mx,my)
17:35:00 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :  | trace ("loop " ++ show (x,y) ++ " " ++ show (dx,dy) ++ " " ++ show (mx,my)) False = undefined
17:35:00 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :  | x `ltx` mx && y `lty` my = (mx+dx, my+dy)
17:35:00 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :  | x `gtx` mx || y `gtx` my = loop (x-dx, y-dy) (dx,dy) (mx,my)
17:35:00 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :  | otherwise                = (x,y)
17:35:05 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :    where ltx, gtx, lty, gty :: Value -> Value -> Bool
17:35:06 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          ltx = posneg dx (<) (>)
17:35:08 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          gtx = posneg dx (>) (<)
17:35:10 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          lty = posneg dy (<) (>)
17:35:12 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          gty = posneg dy (>) (<)
17:35:14 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :ANY IDEAS DEEWIANT
17:35:21 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :where
17:35:24 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :    let mx = posneg dx mnx mxx
17:35:24 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :        my = posneg dy mny mxy
17:35:37 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :so let's see
17:35:44 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :m = mx
17:35:47 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :and lt/gt are lt/gt
17:35:47 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :so
17:35:54 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :x < mnx && y < mnx
17:35:54 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :aha
17:35:56 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :needs to be ||
17:36:00 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :although i recall that broke something
