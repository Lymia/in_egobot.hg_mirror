([-{[(+)*120[+.]]}>[-[++[+[+[-----[-[(+)*59<<[-.]]]]]]]>][++[+.]]>
])%280])%280])%275]<)%280)*20>(+.+..+)*-1
}[([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{([{
;we've been waiting too long for the enemy to clear this decoy even though we know they have messed with it
;it's unlikely that we can prevent any sort of clear on our flag so let's just go on full offence
(>)*5(>([(+)*8([-{[(-)*112[-.]>]}])%16])*2)*21
