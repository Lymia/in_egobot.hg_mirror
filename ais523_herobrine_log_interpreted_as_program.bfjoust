11:49:28 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :mergeByteString (ox,oy) fs s = fs'
11:49:28 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :  where (_,fs',_) = B.foldl' byte ((ox,oy),fs,False) s
11:49:28 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :        byte (p@(x,y),fs,lastWasCR) w
11:49:28 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          | w == ff || (w == lf && lastWasCR) = (p, fs, False)
11:49:29 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          | w == cr || w == lf = ((x,y+1), fs, w == cr)
11:49:31 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          | w == space = ((x+1,y), fs, False)
11:49:35 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :          | otherwise = ((x+1,y), insertFS p (fromIntegral w) fs, False)
11:49:37 :elliott!~elliott@unaffiliated/elliott PRIVMSG #esoteric :even supports \r<FF>\n as two newlines, I think
11:49:48 :Deewiant!~deewiant@cs186230.pp.htv.fi PRIVMSG #esoteric :Yep
