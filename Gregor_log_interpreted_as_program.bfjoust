17:48:41 <elliott> pikhq: look at my beautiful hideous code
17:48:43 <elliott> mergeByteString :: Vector -> FungeSpace -> ByteString -> (Vector, FungeSpace)
17:48:43 <elliott> mergeByteString (ox,oy) fs s = ((bx,by),fs')
17:48:43 <elliott>   where ((_,by),fs',_,bx) = B.foldl' byte ((ox,oy),fs,False,0) s
17:48:43 <elliott>         byte (p@(x,y),fs,lastWasCR,biggestX) w
17:48:44 <elliott>           | w == ff || (w == lf && lastWasCR) = (p, fs, False, biggestX)
17:48:46 <elliott>           | w == cr || w == lf = ((ox,y+1), fs, w == cr, biggestX)
17:48:48 <elliott>           | w == space = ((x+1,y), fs, False, max (x+1) biggestX)
17:48:50 <elliott>           | otherwise = ((x+1,y), insertFS p (fromIntegral w) fs, False, max (x+1) biggestX)
